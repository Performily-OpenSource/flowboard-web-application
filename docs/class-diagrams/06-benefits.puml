@startuml 06-benefits
title Benefits Bounded Context - Class Diagram (Angular frontend)
!pragma layout smetana
set separator none
skinparam dpi 110
skinparam shadowing false
skinparam defaultFontName Inter, Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam ArrowColor #43474E
skinparam class {
  BorderColor #43474E
  HeaderBackgroundColor #FFFFFF
  BackgroundColor<<ACL>> #D9D9F3
  BackgroundColor<<Api>> #FAD4C0
  BackgroundColor<<Assembler>> #FCE4EC
  BackgroundColor<<Component>> #DDEEF0
  BackgroundColor<<Endpoint>> #FAD4C0
  BackgroundColor<<Entity>> #D3E4FF
  BackgroundColor<<Enumeration>> #EADCF2
  BackgroundColor<<Interface>> #EAEAEA
  BackgroundColor<<Pipe>> #EAEAEA
  BackgroundColor<<Read Model>> #F3E9D2
  BackgroundColor<<Resource>> #F3E9D2
  BackgroundColor<<Store>> #FFE8A3
  BackgroundColor<<Value Object>> #D8F0D2
  BackgroundColor<<View>> #DDEEF0
  BackgroundColor<<Shared Kernel>> #F2F2F2
}
skinparam package {
  BorderColor #73777F
  FontColor #191C20
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #C3C6CF
}
legend top left
  |<#D9D9F3> **L** | ACL |
  |<#FAD4C0> **I** | Api |
  |<#FCE4EC> **A** | Assembler |
  |<#DDEEF0> **C** | Component |
  |<#FAD4C0> **P** | Endpoint |
  |<#D3E4FF> **E** | Entity |
  |<#EADCF2> **N** | Enumeration |
  |<#EAEAEA> **I** | Interface |
  |<#EAEAEA> **F** | Pipe |
  |<#F3E9D2> **M** | Read Model |
  |<#F3E9D2> **R** | Resource |
  |<#FFE8A3> **S** | Store |
  |<#D8F0D2> **V** | Value Object |
  |<#DDEEF0> **W** | View |
endlegend

package "benefits/domain/model" {
  enum "AssignmentStatus" as benefits__AssignmentStatus <<(N,#9C6FB7) Enumeration>> {
    ASSIGNED
    DELIVERED
    CANCELLED
  }
  class "BenefitAssignment" as benefits__BenefitAssignment <<(E,#4A7BD0) Entity>> {
    - id : number
    - benefitTypeId : number
    - employeeId : number
    - sourceAreaId : number | null
    - validity : DateRange
    - quantity : number
    - status : AssignmentStatus
    - delivery : BenefitDelivery | null
    - benefitType : BenefitType | null
    --
    + BenefitAssignment(props)
    + {static} forArea(benefitTypeId : number, areaId : number, activeEmployeeIds : number[], …) : BenefitAssignment[]
    + registerDelivery(deliveredOn : string, registeredBy : number, notes : string) : void
    + cancel() : void
    + isDelivered() : boolean
    + isCancelled() : boolean
    + isValidOn(date : string) : boolean
    + conflictsWith(benefitTypeId : number, employeeId : number, validity : DateRange) : boolean
  }
  class "BenefitDelivery" as benefits__BenefitDelivery <<(E,#4A7BD0) Entity>> {
    - id : number
    - deliveredOn : string
    - registeredBy : number
    - notes : string
    --
    + BenefitDelivery(props)
  }
  enum "BenefitPeriodicity" as benefits__BenefitPeriodicity <<(N,#9C6FB7) Enumeration>> {
    MONTHLY
    SEMIANNUAL
    ANNUAL
  }
  class "BenefitType" as benefits__BenefitType <<(E,#4A7BD0) Entity>> {
    - id : number
    - name : string
    - description : string
    - hasBalance : boolean
    - unit : BenefitUnit
    - periodicity : BenefitPeriodicity
    - active : boolean
    --
    + BenefitType(props)
    + activate() : void
    + deactivate() : void
    + hasSameName(name : string) : boolean
  }
  enum "BenefitUnit" as benefits__BenefitUnit <<(N,#9C6FB7) Enumeration>> {
    MONEY
    DAYS
    UNITS
  }
  class "VacationBalance" as benefits__VacationBalance <<(E,#4A7BD0) Entity>> {
    - id : number
    - employeeId : number
    - accruedDays : number
    - usedDays : number
    - movements : VacationMovement[]
    --
    + VacationBalance(props)
    + availableDays() : number
    + usagePercentage() : number
    + hasEnough(days : number) : boolean
    + accrue(days : number) : void
    + debit(days : number, requestId : number) : void
    + revertDebit(days : number, requestId : number) : void
    + availableAfterAdjustment(days : number) : number
    + adjust(days : number, reason : string, authorId : number) : void
  }
  class "VacationMovement" as benefits__VacationMovement <<(E,#4A7BD0) Entity>> {
    - id : number
    - type : VacationMovementType
    - days : number
    - reason : string
    - authorId : number | null
    - requestId : number | null
    - occurredAt : string
    --
    + VacationMovement(props)
  }
  enum "VacationMovementType" as benefits__VacationMovementType <<(N,#9C6FB7) Enumeration>> {
    ACCRUAL
    USAGE
    REVERSAL
    MANUAL_ADJUSTMENT
  }
}

package "benefits/application" {
  class "AssignBenefitCommand" as benefits__AssignBenefitCommand <<(M,#B8993A) Read Model>> {
    + benefitTypeId : number
    + employeeId : number | null
    + areaId : number | null
    + validity : DateRange
    + quantity : number
  }
  class "AssignmentPlan" as benefits__AssignmentPlan <<(M,#B8993A) Read Model>> {
    + employeeIds : number[]
    + conflictingEmployeeIds : number[]
  }
  class "BenefitsStore" as benefits__BenefitsStore <<(S,#E0A800) Store>> {
    + loading : Signal<boolean>
    + error : Signal<string | null>
    + benefitTypes : Signal
    + activeBenefitTypes : Signal
    + assignments : Signal
    + deliveredAssignments : Signal
    + vacationBalances : Signal<VacationBalance[]>
    --
    + reachOf(benefitTypeId : number) : number
    + isBenefitNameTaken(name : string, excludedId : number | null) : boolean
    + planAssignment(benefitTypeId : number, employeeIds : number[], validity : DateRange) : AssignmentPlan
    + findConflict(benefitTypeId : number, employeeId : number, validity : DateRange) : BenefitAssignment | undefined
    + getBalanceByEmployeeId(employeeId : number) : VacationBalance | undefined
    + addBenefitType(benefitType : BenefitType) : void
    + updateBenefitType(benefitType : BenefitType) : void
    + toggleBenefitTypeStatus(benefitType : BenefitType) : void
    + assignBenefit(command : AssignBenefitCommand) : void
    + registerDelivery(assignment : BenefitAssignment, deliveredOn : string, notes : string) : void
    + cancelAssignment(assignment : BenefitAssignment) : void
    + adjustVacationBalance(balance : VacationBalance, days : number, reason : string) : void
    + debitVacationDays(employeeId : number, days : number, requestId : number) : void
    + clearError() : void
  }
}

package "benefits/infrastructure" {
  class "AreaSummary" as benefits__AreaSummary <<(I,#808080) Interface>> {
    + id : number
    + name : string
    + active : boolean
  }
  class "BenefitAssignmentAssembler" as benefits__BenefitAssignmentAssembler <<(A,#D6638C) Assembler>> {
    + toEntityFromResource(resource : BenefitAssignmentResource) : BenefitAssignment
    + toResourceFromEntity(entity : BenefitAssignment) : BenefitAssignmentResource
    + toEntitiesFromResponse(response : BenefitAssignmentsResponse) : BenefitAssignment[]
  }
  class "BenefitAssignmentResource" as benefits__BenefitAssignmentResource <<(R,#B8993A) Resource>> {
    + id : number
    + benefitTypeId : number
    + employeeId : number
    + sourceAreaId : number | null
    + validFrom : string
    + validTo : string
    + quantity : number
    + status : string
    + delivery : BenefitDeliveryResource | null
  }
  class "BenefitAssignmentsApiEndpoint" as benefits__BenefitAssignmentsApiEndpoint <<(P,#E07B39) Endpoint>>
  class "BenefitAssignmentsResponse" as benefits__BenefitAssignmentsResponse <<(R,#B8993A) Resource>> {
    + benefitAssignments : BenefitAssignmentResource[]
  }
  class "BenefitDeliveryResource" as benefits__BenefitDeliveryResource <<(R,#B8993A) Resource>> {
    + id : number
    + deliveredOn : string
    + registeredBy : number
    + notes : string
  }
  class "BenefitTypeAssembler" as benefits__BenefitTypeAssembler <<(A,#D6638C) Assembler>> {
    + toEntityFromResource(resource : BenefitTypeResource) : BenefitType
    + toResourceFromEntity(entity : BenefitType) : BenefitTypeResource
    + toEntitiesFromResponse(response : BenefitTypesResponse) : BenefitType[]
  }
  class "BenefitTypeResource" as benefits__BenefitTypeResource <<(R,#B8993A) Resource>> {
    + id : number
    + name : string
    + description : string
    + hasBalance : boolean
    + unit : string
    + periodicity : string
    + active : boolean
  }
  class "BenefitTypesApiEndpoint" as benefits__BenefitTypesApiEndpoint <<(P,#E07B39) Endpoint>>
  class "BenefitTypesResponse" as benefits__BenefitTypesResponse <<(R,#B8993A) Resource>> {
    + benefitTypes : BenefitTypeResource[]
  }
  class "BenefitsApi" as benefits__BenefitsApi <<(I,#E07B39) Api>> {
    + getBenefitTypes() : Observable<BenefitType[]>
    + createBenefitType(benefitType : BenefitType) : Observable<BenefitType>
    + updateBenefitType(benefitType : BenefitType) : Observable<BenefitType>
    + getBenefitAssignments() : Observable<BenefitAssignment[…
    + createBenefitAssignment(assignment : BenefitAssignment) : Observable<BenefitAssignment>
    + updateBenefitAssignment(assignment : BenefitAssignment) : Observable<BenefitAssignment>
    + getVacationBalances() : Observable<VacationBalance[]>
    + updateVacationBalance(balance : VacationBalance) : Observable<VacationBalance>
  }
  class "EmployeeSummary" as benefits__EmployeeSummary <<(I,#808080) Interface>> {
    + id : number
    + fullName : string
    + initials : string
    + positionTitle : string
    + areaId : number
    + areaName : string
    + active : boolean
  }
  class "VacationBalanceAssembler" as benefits__VacationBalanceAssembler <<(A,#D6638C) Assembler>> {
    + toEntityFromResource(resource : VacationBalanceResource) : VacationBalance
    + toResourceFromEntity(entity : VacationBalance) : VacationBalanceResource
    + toEntitiesFromResponse(response : VacationBalancesResponse) : VacationBalance[]
  }
  class "VacationBalanceResource" as benefits__VacationBalanceResource <<(R,#B8993A) Resource>> {
    + id : number
    + employeeId : number
    + accruedDays : number
    + usedDays : number
    + movements : VacationMovementResource[]
  }
  class "VacationBalancesApiEndpoint" as benefits__VacationBalancesApiEndpoint <<(P,#E07B39) Endpoint>>
  class "VacationBalancesResponse" as benefits__VacationBalancesResponse <<(R,#B8993A) Resource>> {
    + vacationBalances : VacationBalanceResource[]
  }
  class "VacationMovementResource" as benefits__VacationMovementResource <<(R,#B8993A) Resource>> {
    + id : number
    + type : string
    + days : number
    + reason : string
    + authorId : number | null
    + requestId : number | null
    + occurredAt : string
  }
  class "WorkspaceAcl" as benefits__WorkspaceAcl <<(L,#6A6AC4) ACL>> {
    + employees : Signal<EmployeeSummary[]>
    + activeEmployees : Signal
    + areas : Signal<AreaSummary[]>
    + activeAreas : Signal
    --
    + findEmployee(id : number) : EmployeeSummary | undefined
    + activeEmployeeIdsOfArea(areaId : number) : number[]
  }
}

