@startuml 04-attendance
title Attendance Bounded Context - Class Diagram (Angular frontend)
!pragma layout smetana
set separator none
skinparam dpi 110
skinparam shadowing false
skinparam defaultFontName Inter, Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam ArrowColor #43474E
skinparam class {
  BorderColor #43474E
  HeaderBackgroundColor #FFFFFF
  BackgroundColor<<ACL>> #D9D9F3
  BackgroundColor<<Api>> #FAD4C0
  BackgroundColor<<Assembler>> #FCE4EC
  BackgroundColor<<Component>> #DDEEF0
  BackgroundColor<<Endpoint>> #FAD4C0
  BackgroundColor<<Entity>> #D3E4FF
  BackgroundColor<<Enumeration>> #EADCF2
  BackgroundColor<<Interface>> #EAEAEA
  BackgroundColor<<Read Model>> #F3E9D2
  BackgroundColor<<Resource>> #F3E9D2
  BackgroundColor<<Store>> #FFE8A3
  BackgroundColor<<View>> #DDEEF0
  BackgroundColor<<Shared Kernel>> #F2F2F2
}
skinparam package {
  BorderColor #73777F
  FontColor #191C20
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #C3C6CF
}
legend top left
  |<#D9D9F3> **L** | ACL |
  |<#FAD4C0> **I** | Api |
  |<#FCE4EC> **A** | Assembler |
  |<#DDEEF0> **C** | Component |
  |<#FAD4C0> **P** | Endpoint |
  |<#D3E4FF> **E** | Entity |
  |<#EADCF2> **N** | Enumeration |
  |<#EAEAEA> **I** | Interface |
  |<#F3E9D2> **M** | Read Model |
  |<#F3E9D2> **R** | Resource |
  |<#FFE8A3> **S** | Store |
  |<#DDEEF0> **W** | View |
endlegend

package "attendance/domain/model" {
  class "AttendanceArea" as attendance__AttendanceArea <<(E,#4A7BD0) Entity>> {
    + AttendanceArea(id : number, name : string)
  }
  class "AttendanceEmployee" as attendance__AttendanceEmployee <<(E,#4A7BD0) Entity>> {
    + AttendanceEmployee(id : number, fullName : string, areaId : number)
  }
  class "AttendanceRecord" as attendance__AttendanceRecord <<(E,#4A7BD0) Entity>> {
    - id : number
    - employeeId : number
    - workDate : string
    - checkInTime : string | null
    - checkOutTime : string | null
    - effectiveHours : number | null
    - overtimeHours : number | null
    - status : AttendanceStatus
    - justificationReason : string | null
    - justificationDocumentName : string | null
    --
    + AttendanceRecord(props)
    + {static} fromPunches(employeeId : number, workDate : string, punches : Punch[], …) : AttendanceRecord
    + isComplete() : boolean
    + isIncomplete() : boolean
    + isAbsent() : boolean
    + isJustified() : boolean
  }
  enum "AttendanceStatus" as attendance__AttendanceStatus <<(N,#9C6FB7) Enumeration>> {
    ON_TIME
    LATE
    ABSENT
    JUSTIFIED
    INCOMPLETE
  }
  class "Punch" as attendance__Punch <<(E,#4A7BD0) Entity>> {
    - id : number
    - employeeId : number
    - attendanceRecordId : number
    - punchedAt : string
    - type : PunchType
    --
    + Punch(props)
  }
  enum "PunchType" as attendance__PunchType <<(N,#9C6FB7) Enumeration>> {
    CHECK_IN
    CHECK_OUT
  }
  class "WorkSchedule" as attendance__WorkSchedule <<(E,#4A7BD0) Entity>> {
    - id : number
    - positionId : number
    - shiftStartTime : string
    - shiftEndTime : string
    - lateToleranceMinutes : number
    - workingDays : number[]
    --
    + WorkSchedule(props)
    + expectedHours() : number
    + isWorkingDay(date : string) : boolean
    + isLate(checkInTime : string) : boolean
  }
}

package "attendance/application" {
  class "AttendanceRecordRow" as attendance__AttendanceRecordRow <<(M,#B8993A) Read Model>> {
    + record : AttendanceRecord
