@startuml 07-payroll
title Payroll Bounded Context - Class Diagram (Angular frontend)
!pragma layout smetana
set separator none
skinparam dpi 110
skinparam shadowing false
skinparam defaultFontName Inter, Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam ArrowColor #43474E
skinparam class {
  BorderColor #43474E
  HeaderBackgroundColor #FFFFFF
  BackgroundColor<<ACL>> #D9D9F3
  BackgroundColor<<Api>> #FAD4C0
  BackgroundColor<<Assembler>> #FCE4EC
  BackgroundColor<<Component>> #DDEEF0
  BackgroundColor<<Endpoint>> #FAD4C0
  BackgroundColor<<Entity>> #D3E4FF
  BackgroundColor<<Enumeration>> #EADCF2
  BackgroundColor<<Interface>> #EAEAEA
  BackgroundColor<<Pipe>> #EAEAEA
  BackgroundColor<<Read Model>> #F3E9D2
  BackgroundColor<<Resource>> #F3E9D2
  BackgroundColor<<Store>> #FFE8A3
  BackgroundColor<<Value Object>> #D8F0D2
  BackgroundColor<<View>> #DDEEF0
  BackgroundColor<<Shared Kernel>> #F2F2F2
}
skinparam package {
  BorderColor #73777F
  FontColor #191C20
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #C3C6CF
}
legend top left
  |<#D9D9F3> **L** | ACL |
  |<#FAD4C0> **I** | Api |
  |<#FCE4EC> **A** | Assembler |
  |<#DDEEF0> **C** | Component |
  |<#FAD4C0> **P** | Endpoint |
  |<#D3E4FF> **E** | Entity |
  |<#EADCF2> **N** | Enumeration |
  |<#EAEAEA> **I** | Interface |
  |<#EAEAEA> **F** | Pipe |
  |<#F3E9D2> **M** | Read Model |
  |<#F3E9D2> **R** | Resource |
  |<#FFE8A3> **S** | Store |
  |<#D8F0D2> **V** | Value Object |
  |<#DDEEF0> **W** | View |
endlegend

package "payroll/domain/model" {
